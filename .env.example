# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# `.env*` is git-ignored; this template is the only version that is committed.
# Never put a secret in a NEXT_PUBLIC_* variable — those are inlined into the
# client bundle and are publicly readable.
# ---------------------------------------------------------------------------

# Canonical origin of the deployed site, no trailing slash.
# Drives canonical tags, OpenGraph URLs, robots.txt and sitemap.xml.
# Leave unset for local development (falls back to the production URL).
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only. Form provider that receives POST /api/contact submissions
# (Formspree / Basin / a CRM webhook / your own handler).
# While this is empty the endpoint answers 503 and the UI says the form is not
# connected. It never reports a message as sent.
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Optional. Public hint used by the contact form to explain its state.
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Optional. Analytics provider id, only if you have configured the matching
# integration. The project ships with no analytics, no pixels and no cookies.
# NEXT_PUBLIC_GA_ID=
